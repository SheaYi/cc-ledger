{
  "name": "cc-ledger",
  "version": "1.1.12",
  "private": true,
  "description": "CC记账 — Docker 化的多人协作记账系统",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/cli/migrate.ts",
    "db:seed": "tsx src/db/cli/seed.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "parity": "tsx scripts/check-amounts-parity.mts",
    "audit:imports": "node scripts/audit-esm-imports.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:migration": "node scripts/audit-migration-boundary.mjs",
    "audit:url": "node scripts/audit-url-encoding.mjs",
    "audit:routes": "node scripts/audit-routes.mjs",
    "smoke": "node scripts/smoke-stage3.mjs",
    "smoke:3": "node scripts/smoke-stage3.mjs",
    "smoke:4": "node scripts/smoke-stage4.mjs",
    "smoke:8": "node scripts/smoke-stage8.mjs",
    "smoke:9": "node scripts/smoke-stage9.mjs",
    "smoke:10": "node scripts/smoke-stage10.mjs",
    "smoke:11": "node scripts/smoke-stage11.mjs",
    "smoke:12": "node scripts/smoke-stage12.mjs",
    "smoke:13": "node scripts/smoke-boundary-disclosure.mjs",
    "smoke:18": "node scripts/smoke-stats-filter.mjs",
    "smoke:19": "node scripts/smoke-stats-range-trend.mjs",
    "test:install": "tsx scripts/test-installment-split.mjs",
    "test:schedule": "tsx scripts/test-recurring-schedule.mjs",
    "icons": "node scripts/gen-pwa-icons.mjs",
    "audit:deploydoc": "node scripts/audit-deploy-doc.mjs",
    "verify": "npm run typecheck && npm run audit:schema && npm run audit:deploydoc && npm run test && npm run parity && npm run audit:imports && npm run audit:syntax && npm run audit:template && npm run audit:nav && npm run audit:contrast && npm run audit:url && npm run audit:routes && npm run audit:migration && npm run smoke:3 && npm run smoke:4 && npm run smoke:8 && npm run smoke:9 && npm run smoke:10 && npm run test:schedule && npm run smoke:11 && npm run test:install && npm run smoke:12 && npm run smoke:13 && npm run smoke:14 && npm run smoke:15 && npm run smoke:16 && npm run smoke:17 && npm run smoke:18 && npm run smoke:19",
    "audit:syntax": "node scripts/audit-frontend-syntax.mjs",
    "probe:boundary": "node scripts/probe-boundary-ui.mjs",
    "probe:recon": "node scripts/probe-reconciliations-ui.mjs",
    "probe:install": "node scripts/probe-installments-ui.mjs",
    "smoke:14": "node scripts/smoke-stage14.mjs",
    "probe:reports": "node scripts/probe-reports-ui.mjs",
    "audit:schema": "node scripts/audit-schema.mjs",
    "smoke:15": "node scripts/smoke-stage15.mjs",
    "probe:15": "node scripts/probe-stage15-ui.mjs",
    "audit:ledger": "node scripts/audit-ledger-invariants.mjs",
    "smoke:16": "node scripts/smoke-stage16.mjs",
    "probe:debts": "node scripts/probe-debts-ui.mjs",
    "audit:template": "node scripts/audit-template-backticks.mjs",
    "probe:task5": "node scripts/probe-task5-ui.mjs",
    "audit:nav": "node scripts/audit-nav-icons.mjs",
    "probe:report": "node scripts/probe-report-ui.mjs",
    "probe:importmap": "node scripts/probe-import-mapping-ui.mjs",
    "probe:ledgers": "node scripts/probe-ledger-cards.mjs",
    "probe:spacing": "node scripts/probe-spacing.mjs",
    "smoke:17": "node scripts/smoke-recon-tools.mjs",
    "probe:recontools": "node scripts/probe-recon-tools.mjs",
    "probe:mobile": "node scripts/probe-mobile-ui.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.0.3",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.2.0",
    "jimp": "^1.6.1",
    "node-cron": "^3.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.28.1",
    "lucide-static": "^1.55.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
