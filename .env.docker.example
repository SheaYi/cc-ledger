# =====================================================================
#  CC记账 · docker compose 专用 .env 模板
#
#  用法（NAS 上）：
#     cd /volume1/docker/cc-ledger
#     cp .env.docker.example .env
#     nano .env                 # 改下面两处必填
#     chmod 600 .env
#
#  这个文件只被 `docker compose` 读取，用来替换 docker-compose.yml 里的
#  ${JWT_SECRET} / ${PUBLIC_BASE_URL} / ${CC_IMAGE} / ${DATA_HOST_DIR}。
#  它**不会**进入容器 —— 容器里的环境变量来自 compose 的 environment: 段。
#  本地开发用的完整配置看 .env.example（那份是给 node 直接跑的）。
#
#  ⚠️ 值不要加引号：.env 里写 JWT_SECRET="abc"，引号会被当成密钥的一部分。
# =====================================================================

# ===== 必填 1/2：令牌签名密钥 =====
# 生成：openssl rand -base64 48
# 换掉它 = 所有已登录设备的 token 立即失效（要重新登录），账目数据不受影响
JWT_SECRET=粘贴 openssl rand -base64 48 的输出

# ===== 必填 2/2：NAS 实际访问地址 =====
# 用于生成邀请链接 / 二维码；写 localhost 会把别人引导到他自己电脑
PUBLIC_BASE_URL=http://192.168.1.10:3000

# ===== 镜像来源 =====
# 用 GitHub Actions 构建好的镜像（NAS 上不编译）。注释掉这行 = 本地构建
CC_IMAGE=ghcr.io/shayi/cc-ledger:latest

# ===== 数据落点 =====
# 宿主机目录（容器内固定 /data）。写绝对路径最稳；不写则默认 <项目目录>/data
# ⚠️ 这个目录必须先 mkdir + chown 1001:1001，否则容器报 SQLITE_CANTOPEN
DATA_HOST_DIR=/volume1/docker/cc-ledger/data
