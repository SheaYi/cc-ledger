# ============ 运行环境 ============
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TZ=Asia/Shanghai

# ============ 数据目录 ============
DATA_DIR=./data
DB_PATH=./data/cc-ledger.db
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups

# ============ 认证密钥（生产必须替换！）============
# 生成：openssl rand -base64 48
JWT_SECRET=dev-secret-change-me-please-use-a-random-48-bytes
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
# 移动端 refresh token 有效期（PWA 长期免登录）
JWT_REFRESH_EXPIRES_MOBILE=90d

# ============ 对外地址 ============
# 用于生成邀请链接/二维码，局域网填 http://<NAS-IP>:3000
PUBLIC_BASE_URL=http://localhost:3000

# ============ 限流（docs/04 §1.6 生产基线）============
# 本地反复注册测试账号时可临时调大，例如 100
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=3

# ============ 日志与调度 ============
LOG_LEVEL=debug
ENABLE_SCHEDULER=true
BACKUP_ENABLED=false
BACKUP_RETENTION_DAYS=14

# ============ Docker 专用（仅 docker-compose.yml 读取，本地开发用不到）============
# 数据落在 NAS 哪个目录（容器内固定是 /data）。留空/不写 = 项目目录下的 data/。
# NAS 上一般不用写：默认就是 /volume1/docker/cc-ledger/data
# DATA_HOST_DIR=/volume1/docker/cc-ledger/data

# 镜像来源：不写 = 本地构建（docker compose up -d --build）
# 写 ghcr 地址 = 直接拉 GitHub Actions 构建好的镜像（NAS 上不用编译）
# CC_IMAGE=ghcr.io/shayi/cc-ledger:latest
