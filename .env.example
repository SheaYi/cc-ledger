# ============ 运行环境 ============
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TZ=Asia/Shanghai

# ============ 数据目录 ============
DATA_DIR=./data
DB_PATH=./data/cc-ledger.db
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups

# ============ 认证密钥（生产必须替换！）============
# 生成：openssl rand -base64 48
JWT_SECRET=dev-secret-change-me-please-use-a-random-48-bytes
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
# 移动端 refresh token 有效期（PWA 长期免登录）
JWT_REFRESH_EXPIRES_MOBILE=90d

# ============ 对外地址 ============
# 用于生成邀请链接/二维码，局域网填 http://<NAS-IP>:3000
PUBLIC_BASE_URL=http://localhost:3000

# ============ 限流（docs/04 §1.6 生产基线）============
# 本地反复注册测试账号时可临时调大，例如 100
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=3

# ============ 日志与调度 ============
LOG_LEVEL=debug
ENABLE_SCHEDULER=true
BACKUP_ENABLED=false
BACKUP_RETENTION_DAYS=14
